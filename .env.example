# Example environment configuration.
# Copy relevant values into .env.development / .env.production, or create a
# .env.local for local overrides. All vars are NEXT_PUBLIC_ (exposed to the
# browser) and inlined at build time — none are secret.

# API / web / UI base URLs
NEXT_PUBLIC_BASE_URL=
NEXT_PUBLIC_BASE_URL_WEB=
NEXT_PUBLIC_BASE_URL_UI=

# Razorpay publishable key (rzp_test_* / rzp_live_*)
NEXT_PUBLIC_PAYMENT_GATEWAY_KEY=

# Google reCAPTCHA site key (public)
NEXT_PUBLIC_CAPTCHA_SITE_KEY=
